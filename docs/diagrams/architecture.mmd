flowchart TD
    User([User at a terminal]) -->|"python -m app"| CLI

    CLI["app/cli.py<br/>build_parser / parse_args<br/>AppConfig.validate"]
    CLI -->|"validated AppConfig"| Controller

    Controller["Application Controller<br/>app.cli.Application"]
    CameraMod["Camera Module<br/>app/camera.py :: Camera"]
    DetectorMod["Detection Module<br/>app/detector.py :: Detector"]
    AnalyticsMod["Analytics Module<br/>app/analytics.py :: FpsCounter / SessionStats"]
    ControlsMod["Controls Module<br/>app/controls.py :: ControlState"]
    RendererMod["Rendering Module<br/>app/renderer.py :: Renderer"]

    Controller --> CameraMod
    Controller --> DetectorMod
    Controller --> AnalyticsMod
    Controller --> ControlsMod
    Controller --> RendererMod

    CameraMod -->|"BGR frame (NumPy array)"| DetectorMod

    YOLO["YOLO11n<br/>Ultralytics + PyTorch<br/>(third-party component)"]
    DetectorMod -->|"frame"| YOLO
    YOLO -->|"raw boxes, class ids, confidences"| DetectorMod
    DetectorMod -->|"list of Detection"| AnalyticsMod

    AnalyticsMod -->|"FrameAnalytics + SessionStats"| Controller
    ControlsMod -->|"ControlAction"| Controller
    Controller --> RendererMod
    RendererMod -->|"annotated frame"| Controller

    Controller --> Window["OpenCV window<br/>live annotated video"]
    Controller --> Outputs["outputs/<br/>snapshot_*.jpg<br/>recording_*.mp4<br/>session_summary.json"]

    Window --> User
    Outputs --> User

