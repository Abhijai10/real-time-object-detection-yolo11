classDiagram
    class Application {
        +config
        +camera
        +detector
        +renderer
        +fps_counter
        +session
        +controls
        +recorder
        +run() int
        +handle_action(action, frame) bool
        +print_banner()
        +print_summary()
    }

    class AppConfig {
        +camera
        +model
        +confidence
        +iou
        +image_size
        +device
        +width
        +height
        +output_dir
        +max_frames
        +display
        +show_help
        +save_summary
        +validate() AppConfig
    }

    class Camera {
        +source
        +width
        +height
        +open() Camera
        +read() tuple
        +release()
        +describe() str
        +is_open bool
        +actual_width int
        +actual_height int
        +reported_fps float
    }

    class Detector {
        +model_path
        +confidence
        +iou
        +device
        +image_size
        +load() Detector
        +warmup(image_size)
        +detect(frame) list
        +set_confidence(value) float
        +class_names
        +is_loaded bool
    }

    class Detection {
        +class_id int
        +class_name str
        +confidence float
        +x1 float
        +y1 float
        +x2 float
        +y2 float
        +bbox tuple
        +bbox_int tuple
        +label str
        +as_dict() dict
    }

    class FpsCounter {
        +window int
        +tick(now) float
        +fps float
        +frame_count int
        +reset()
    }

    class FrameAnalytics {
        +object_count int
        +class_counts dict
        +unique_classes tuple
        +average_confidence float
        +max_confidence float
        +unique_class_count int
        +as_dict() dict
    }

    class SessionStats {
        +frames_processed int
        +total_detections int
        +peak_simultaneous_detections int
        +class_totals
        +update(analytics, fps)
        +reset(keep_start_time)
        +most_frequent_class() tuple
        +top_classes(limit) list
        +as_dict() dict
        +summary_lines() list
        +average_fps float
    }

    class ControlState {
        +confidence float
        +step float
        +show_overlay bool
        +recording bool
        +apply(action) ControlAction
        +history tuple
        +recording_label str
    }

    class ControlAction {
        NONE
        QUIT
        SNAPSHOT
        TOGGLE_RECORDING
        RESET_STATS
        CONFIDENCE_UP
        CONFIDENCE_DOWN
        TOGGLE_OVERLAY
    }

    class Renderer {
        +palette tuple
        +draw_detections(frame, detections)
        +draw_analytics_overlay()
        +draw_help_overlay(frame, lines)
        +draw_recording_indicator(frame, recording)
        +draw_message(frame, message)
        +render()
        +color_for(class_name) tuple
    }

    class VideoRecorder {
        +output_dir
        +fps float
        +start(frame_size, fps) Path
        +write(frame) bool
        +stop() Path
        +is_recording bool
        +frames_written int
    }

    Application --> AppConfig : validates
    Application --> Camera : owns
    Application --> Detector : owns
    Application --> Renderer : owns
    Application --> FpsCounter : owns
    Application --> SessionStats : owns
    Application --> ControlState : owns
    Application --> VideoRecorder : owns

    Detector --> Detection : creates
    ControlState --> ControlAction : applies
    FrameAnalytics --> SessionStats : folded into
    FpsCounter --> SessionStats : fps sample
    Detection --> Renderer : drawn by
    FrameAnalytics --> Renderer : overlay text
    SessionStats --> Renderer : overlay counters
